#!/usr/bin/env bash
# Fast checks on staged files. Install with scripts/install-hooks; run scripts/check-changed for the full set.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=()
while IFS= read -r f; do staged+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#staged[@]}" -gt 0 ] || exit 0

scripts/check-repo-hygiene "${staged[@]}"

swift_files=()
for f in "${staged[@]}"; do case "$f" in apple/*.swift) swift_files+=("$f") ;; esac; done
if [ "${#swift_files[@]}" -gt 0 ]; then
  swift format lint --strict "${swift_files[@]}"
  swiftlint lint --strict --quiet "${swift_files[@]}"
fi

if command -v gitleaks >/dev/null; then
  gitleaks protect --staged --redact --no-banner
else
  echo "warning: gitleaks not installed; secrets were not scanned (brew install gitleaks)" >&2
fi
